{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.ts": { "maxDuration": 15 }
  },
  "rewrites": [
    { "source": "/api/v1/clinica/:ruta*", "destination": "/api/clinica?__ruta=:ruta*" },
    { "source": "/api/v1/dispositivos/:ruta*", "destination": "/api/dispositivos?__ruta=:ruta*" },
    { "source": "/api/v1/interop/:ruta*", "destination": "/api/interop?__ruta=:ruta*" },
    { "source": "/api/v1/investigacion/:ruta*", "destination": "/api/investigacion?__ruta=:ruta*" },
    { "source": "/michi/:ruta*", "destination": "/michi/index.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "redirects": [
    { "source": "/familia", "destination": "/michi/", "permanent": false },
    { "source": "/clinica", "destination": "/insn", "permanent": false },
    { "source": "/demo", "destination": "/michi/?demo=1", "permanent": false },
    { "source": "/demo-insn", "destination": "/insn?demo=1", "permanent": false }
  ],
  "headers": [
    {
      "source": "/michi/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/michi/manifest.webmanifest",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "geolocation=(), camera=(), microphone=(), serial=(self), interest-cohort=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ]
}
