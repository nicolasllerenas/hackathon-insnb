{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "w3c-web-serial"
    ],
    "paths": {
      "@compartido/*": [
        "./compartido/*"
      ],
      "@servicios/*": [
        "./servicios/*"
      ]
    }
  },
  "include": [
    "web/src",
    "compartido",
    "servicios/*/servicio.ts",
    "servicios/*/esquema.ts"
  ]
}
