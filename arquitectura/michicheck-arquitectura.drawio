        <mxCell id="c9" value="&lt;b&gt;Michi · robot gato&lt;/b&gt;&lt;br&gt;ESP32-CAM (OV2640)&lt;br&gt;LED 530 nm a 70° · lente 1:1&lt;br&gt;Bocina: maullido y ronroneo&lt;br&gt;Botón: atender o posponer&lt;br&gt;Latido JSON cada 6 h&lt;br&gt;Órdenes T · C · M · L" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fillColor=#FFFFFF;strokeColor=#F59E0B;" vertex="1" parent="1"><mxGeometry x="235" y="120" width="220" height="150" as="geometry"/></mxCell>
