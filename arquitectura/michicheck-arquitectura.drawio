        <mxCell id="c12" value="&lt;b&gt;App «Mi michi»&lt;/b&gt; · PWA React&lt;br&gt;Mascota, lecciones, premios&lt;br&gt;Dedito → tamizaje&lt;br&gt;Teleconsulta y referencia&lt;br&gt;Robot por USB (Web Serial)&lt;br&gt;Notificaciones push" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fillColor=#FFFFFF;strokeColor=#06B6D4;" vertex="1" parent="1"><mxGeometry x="515" y="125" width="220" height="150" as="geometry"/></mxCell>
