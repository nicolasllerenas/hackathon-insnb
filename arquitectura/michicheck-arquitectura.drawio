        <mxCell id="c16" value="&lt;b&gt;Enrutamiento de Vercel&lt;/b&gt;&lt;br&gt;/api/v1/clinica/*&lt;br&gt;/api/v1/dispositivos/*&lt;br&gt;/api/v1/interop/*&lt;br&gt;/api/v1/investigacion/*&lt;br&gt;&lt;br&gt;&lt;b&gt;Seguridad&lt;/b&gt;&lt;br&gt;Token clínico (Bearer)&lt;br&gt;Código de vinculación para la familia y el michi&lt;br&gt;CSP, HTTPS y cabeceras&lt;br&gt;Validación Zod en cada servicio&lt;br&gt;Auditoría de cada escritura" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fillColor=#FFFFFF;strokeColor=#8B5CF6;" vertex="1" parent="1"><mxGeometry x="792" y="125" width="166" height="510" as="geometry"/></mxCell>
